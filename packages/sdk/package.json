{
  "name": "@zeroth-ai/sdk",
  "version": "0.1.1",
  "description": "Run a full AI model inside your app, on-device. No servers, no keys, no per-token bill.",
  "keywords": [
    "ai",
    "llm",
    "on-device",
    "offline",
    "local-first",
    "privacy"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test \"dist/**/*.test.js\"",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=20.11"
  },
  "devDependencies": {
    "@types/node": "^20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-zeroth/zeroth.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/ai-zeroth/zeroth#readme",
  "bugs": {
    "url": "https://github.com/ai-zeroth/zeroth/issues"
  },
  "author": "apreezofficial"
}
